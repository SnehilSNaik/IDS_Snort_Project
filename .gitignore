# ============================================================
# .gitignore — IDS_Snort_Project
# ============================================================

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
**/node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── ML Model Artifacts & Datasets ───────────────────────────
**/ml_model/model.pkl
**/ml_model/scaler.pkl
**/ml_model/feature_config.pkl
**/ml_model/autoencoder_model.keras
**/ml_model/autoencoder_scaler.pkl
**/ml_model/autoencoder_threshold.pkl
**/ml_model/dataset/

# ── Live Packet Captures ────────────────────────────────────
**/packet_capture/captured_packets.csv

# ── Runtime Alert Data & State ──────────────────────────────
**/alerts/alerts.json
**/alerts/count.json
**/alerts/clear.flag
**/alerts/*.flag
**/threat_intel/ti_cache.json
**/response/threat_scores.json
**/response/incident_log.json

# ── User Database (contains hashed passwords) ───────────────
**/dashboard/users.json

# ── Vendored Packages & Binaries ────────────────────────────
vendor/
**/vendor/

# ── API Keys & Secrets (NEVER commit these) ─────────────────
.env
*.env
**/.env

# ── Static Distribution ─────────────────────────────────────
static/

# ── Snort Runtime Logs ──────────────────────────────────────
C:/Snort/log/
**/snort/log/

# ── IDE & OS Files ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
.DS_Store
desktop.ini
