# ============================================================
# .gitignore — IDS_Snort_Project
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# ML Model artifacts (generated by train_model.py)
ml_model/model.pkl
ml_model/scaler.pkl
ml_model/feature_config.pkl

# CIC-IDS-2017 dataset (too large for GitHub — download separately)
ml_model/dataset/

# Captured packets (generated at runtime, can be very large)
packet_capture/captured_packets.csv

# Runtime alert data
alerts/alerts.json
alerts/count.json
alerts/clear.flag

# User database (contains hashed passwords)
dashboard/users.json

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Snort logs (generated at runtime)
C:/Snort/log/
